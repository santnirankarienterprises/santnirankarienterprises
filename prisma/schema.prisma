generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id               String            @id @default(cuid())
  fullName         String
  email            String            @unique
  password         String
  role             String            @default("candidate")
  profileCompleted Boolean           @default(false)
  profile          CandidateProfile?
  employerProfile  EmployerProfile?
  payments         Payment[]

  // Forgot Password
  resetOtp       String?
  resetOtpExpiry DateTime?

  resetToken String?

  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model CandidateProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  dateOfBirth DateTime?
  gender      Gender?

  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  highestQualification String?
  college              String?
  passingYear          String?

  skills            String?

  selectedJobField  String?
  preferredJobField String?
  experience        String?

  // Experienced Candidate Fields
  expIndustry       String?
  expJobProfile     String?
  expLocation       String?
  expQualification  String?
  expTotalYears     String?
  expPastSalary     String?
  expExpectedSalary String?

  status String @default("Applied")

  headline String?
  about    String?
  resumeUrl String?

  interviews Interview[]
  placementFee PlacementFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// This is separate from the Premium/registration Payment model. It records
// the agency fee collected after a candidate is placed, including instalments.
model PlacementFee {
  id          String   @id @default(cuid())
  candidateId String   @unique
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  targetAmount Int     @default(0) // paise
  notes       String?
  payments    PlacementFeePayment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlacementFeePayment {
  id             String       @id @default(cuid())
  placementFeeId String
  placementFee   PlacementFee @relation(fields: [placementFeeId], references: [id], onDelete: Cascade)
  amount         Int          // paise
  mode           String       @default("CASH")
  note           String?
  receivedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
}

model Interview {
  id               String           @id @default(cuid())
  candidateId      String
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  companyName      String
  designation      String?
  hrName           String?
  date             DateTime
  time             String
  location         String
  status           String           @default("SCHEDULED")
  
  createdAt        DateTime         @default(now())
}

model PasswordResetOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mode              String   @default("ONLINE")
  
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  receiptNumber     String?  @unique
  
  amount            Int
  currency          String   @default("INR")
  status            String   @default("SUCCESS")
  createdAt         DateTime @default(now())
}

model EmployerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerName       String
  companyName        String
  phone              String
  email              String
  companyAddress     String
  candidatesRequired Int
  status             String   @default("PENDING")
  selectedJobField   String?
  preferredJobField  String?
  
  requirements       EmployerRequirement[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EmployerRequirement {
  id                   String          @id @default(cuid())
  employerProfileId    String
  employerProfile      EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  
  jobCategory          String
  preferredJobCategory String?
  numberOfCandidates   Int
  field                String?
  status               String          @default("PENDING") // PENDING, IN_PROGRESS, FULFILLED
  
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model GlobalSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model FastApplicant {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  resumeUrl String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
